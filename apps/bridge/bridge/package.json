    "@types/node": "catalog:",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.0"
  }
}
