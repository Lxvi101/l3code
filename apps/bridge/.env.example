# ── T3 Code Server ─────────────────────────────────────────────
# Base T3 websocket URL; the bridge normalizes this to /ws automatically.
T3_WS_URL=ws://localhost:3773
# T3_AUTH_TOKEN=             # Optional bearer session token; exchanged for wsToken automatically

# ── Project ────────────────────────────────────────────────────
# T3_PROJECT_ID=             # Auto-selects first project if unset

# ── Workflow ───────────────────────────────────────────────────
# WORKFLOW=coder-reviewer    # "coder-reviewer" | "task-queue"

# ── Agent Models ───────────────────────────────────────────────
# Each agent can use a different provider and model.
# Provider: "claudeAgent" (Claude) or "codex" (OpenAI/ChatGPT)
#
# Example: Claude coder + Claude reviewer (default)
CODER_PROVIDER=claudeAgent
CODER_MODEL=claude-sonnet-4-6
REVIEWER_PROVIDER=claudeAgent
REVIEWER_MODEL=claude-sonnet-4-6

# Example: Codex coder + Claude Opus reviewer
# CODER_PROVIDER=codex
# CODER_MODEL=o4-mini
# REVIEWER_PROVIDER=claudeAgent
# REVIEWER_MODEL=claude-opus-4

# ── Effort / Model Options ────────────────────────────────────
# Claude effort:  low | medium | high | max | ultrathink
# Codex effort:   low | medium | high | xhigh
# CODER_EFFORT=high
# REVIEWER_EFFORT=high

# Extended thinking (Claude only, boolean)
# CODER_THINKING=true
# REVIEWER_THINKING=true

# Fast mode (both providers, boolean — lower latency, lower quality)
# CODER_FAST_MODE=false
# REVIEWER_FAST_MODE=false

# ── Execution ──────────────────────────────────────────────────
MAX_ITERATIONS=20            # Max coder-reviewer cycles
TURN_TIMEOUT_MS=600000       # 10 minutes per turn
RUNTIME_MODE=full-access     # "full-access" | "approval-required"

# ── Completion Detection ───────────────────────────────────────
# Regex to detect reviewer approval. Default anchors to line-start
# so "Not LGTM" won't false-positive. Supports markdown bold (**LGTM**).
# LGTM_PATTERN=^\s*\*{0,2}LGTM\*{0,2}

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info               # "debug" | "info" | "warn" | "error"
# LOG_FILE=bridge.log        # Log to file (in addition to console)

# ── State Persistence ─────────────────────────────────────────
# STATE_DIR=.bridge-state    # Directory for crash-safe state files

# ── Notifications ──────────────────────────────────────────────
# WEBHOOK_URL=               # POST to this URL on completion/error

# ── Task File ─────────────────────────────────────────────────
# TASK_FILE=task.md           # Path to task description file
