# THE RELAY — Chat Relay service for T3 Code (systemd, runs on boot, restarts on crash)
#
# Automated install: ./deploy/install-service.sh --with-relay  (see --help)
#
# THE RELAY connects to a running T3 Code server and creates "chat pairs" —
# two AI threads that automatically ping-pong messages to each other.
# See apps/chat-relay/bridge.md for full documentation.
#
# Manual: set User/Group, WorkingDirectory, ExecStart (`which bun` as that user).
# Services do not load nvm/login shells — set PATH explicitly.

[Unit]
Description=THE RELAY — T3 Code Chat Relay (agent-to-agent ping-pong)
After=network-online.target t3code.service
Wants=network-online.target
Requires=t3code.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=levi
Group=levi
WorkingDirectory=/home/levi/t3code/t3code

Environment=NODE_ENV=production
Environment="HOME=/home/levi"
Environment="PATH=/home/levi/.local/bin:/home/levi/.nvm/versions/node/v22.22.1/bin:/home/levi/.bun/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RELAY_SERVER_PORT=4400"
ExecStart=/home/levi/.bun/bin/bun run --cwd apps/chat-relay start

Restart=always
RestartSec=5

# Hardening (optional; relax if something breaks)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
