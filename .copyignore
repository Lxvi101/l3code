# Autogenerated .copyignore. Edit to customize.
# Supports glob patterns and wildcards (same syntax as .gitignore).
#
# Special flags (prefix with @):
#   @include-tree    - Include file/folder tree at the beginning of output

@include-tree

# VCS & editor
.git/
.gitignore
.svn/
.hg/
.idea/
.vscode/

apps/marketing
apps/desktop

# Python caches
__pycache__/
*.pyc
*.pyo

# Builds & caches
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
coverage/
bin/
obj/
target/

# Dependencies
node_modules/
.yarn/
.pnpm-store/

# Lock files
pnpm-lock.yaml
package-lock.json
yarn.lock
composer.lock
Gemfile.lock
Cargo.lock

# Env & logs
.env
.env.*
*.log
*.lock
yarn-error.log
npm-debug.log

# OS files
.DS_Store
Thumbs.db

# Common binary/generated file extensions
*.vsix
*.ico
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.zip
*.tar.gz
*.exe
*.dll
*.so
*.dylib

# Ignore this file by default
.copyignore

# From .gitignore
node_modules
.bun
.turbo
.DS_Store
*.log
*.tsbuildinfo
apps/*/dist
.astro
packages/*/dist
.env
.env.local
build/
.logs/
release/
release-mock/
.t3
.idea/
apps/web/.playwright
apps/web/playwright-report
apps/web/src/components/__screenshots__
.vitest-*
__screenshots__/
.tanstack
squashfs-root/
